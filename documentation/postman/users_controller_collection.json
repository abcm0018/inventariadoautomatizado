        {
          "name": "Check User Validity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/is-valid",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "is-valid"]
            },
            "description": "Valida que esté activo, no bloqueado y no expirado."
          },
          "response": []
