{
  "info": {
    "name": "Inventario Automatizado - Workshifts API",
    "description": "Colección completa de endpoints para gestión de asignaciones de turnos (Workshifts). NOTA: La planificación automática se ejecuta mediante CRON cada viernes a las 18:00.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Workshift Management (CRUD)",
      "description": "Operaciones CRUD básicas. SOLO para correcciones administrativas.",
      "item": [
        {
          "name": "Create Workshifts (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2025-02-01\",\n  \"endDate\": \"2025-02-07\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts"]
            },
            "description": "Crea turnos para un rango de fechas. SOLO para correcciones administrativas. Requiere rol ADMIN o SUPERVISOR."
          },
          "response": []
        },
        {
          "name": "Update Workshift (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"shiftId\": 3,\n  \"date\": \"2025-02-15\",\n  \"reason\": \"Cambio por solicitud del empleado - enfermedad\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/{{workshiftId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "{{workshiftId}}"]
            },
            "description": "Actualiza un turno manualmente. SOLO para correcciones administrativas. El campo 'reason' es obligatorio. Requiere rol ADMIN o SUPERVISOR."
          },
          "response": []
        },
        {
          "name": "Get Workshift by ID (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/{{workshiftId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "{{workshiftId}}"]
            },
            "description": "Obtiene un turno específico por su ID con información detallada."
          },
          "response": []
        },
        {
          "name": "Delete Workshift (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/{{workshiftId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "{{workshiftId}}"]
            },
            "description": "Elimina un turno. Solo se puede eliminar si no tiene palets ni fichajes asociados. Requiere rol ADMIN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Search & Filters",
      "description": "Búsqueda y filtrado de turnos con múltiples criterios.",
      "item": [
        {
          "name": "Search with Query Params (GET /search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/search?userId=1&shiftType=MORNING&startDate=2025-02-01&endDate=2025-02-28&page=0&size=20&sort=date,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "search"],
              "query": [
                {
                  "key": "userId",
                  "value": "1",
                  "description": "Opcional. ID del usuario"
                },
                {
                  "key": "shiftId",
                  "value": "2",
                  "description": "Opcional. ID del shift",
                  "disabled": true
                },
                {
                  "key": "shiftType",
                  "value": "MORNING",
                  "description": "Opcional. Tipo de turno: MORNING, AFTERNOON, NIGHT"
                },
                {
                  "key": "startDate",
                  "value": "2025-02-01",
                  "description": "Opcional. Fecha de inicio (ISO DATE)"
                },
                {
                  "key": "endDate",
                  "value": "2025-02-28",
                  "description": "Opcional. Fecha de fin (ISO DATE)"
                },
                {
                  "key": "hasClockings",
                  "value": "true",
                  "description": "Opcional. Filtrar por turnos con/sin fichajes",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "date,desc",
                  "description": "Ordenado por fecha descendente por defecto"
                }
              ]
            },
            "description": "Búsqueda de turnos usando query parameters. Permite filtrar por operario, fecha, tipo, etc. Soporta paginación y ordenamiento."
          },
          "response": []
        },
        {
          "name": "Advanced Search with Body (POST /search)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"shiftId\": 2,\n  \"shiftType\": \"MORNING\",\n  \"startDate\": \"2025-02-01\",\n  \"endDate\": \"2025-02-28\",\n  \"hasClockings\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/search?page=0&size=20&sort=date,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "search"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "date,desc"
                }
              ]
            },
            "description": "Búsqueda avanzada combinando múltiples criterios en el body. Todos los filtros son opcionales y se pueden combinar."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Workshifts",
      "description": "Consulta de turnos específicos de usuarios.",
      "item": [
        {
          "name": "Get User Today Workshift (GET /user/{userId}/today)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/user/{{userId}}/today",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "user", "{{userId}}", "today"]
            },
            "description": "Obtiene el turno de hoy de un usuario específico."
          },
          "response": []
        },
        {
          "name": "Get User Next Workshift (GET /user/{userId}/next)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/user/{{userId}}/next",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "user", "{{userId}}", "next"]
            },
            "description": "Obtiene el próximo turno de un usuario."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Schedule Generation & Maintenance",
      "description": "Generación automática y mantenimiento de planificaciones.",
      "item": [
        {
          "name": "Generate Next Week Schedule (POST /generate-schedule)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/generate-schedule",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "generate-schedule"]
            },
            "description": "⚠️ SOLO PARA TESTING O EMERGENCIAS. Genera planificación de la próxima semana manualmente. En producción esto se ejecuta automáticamente con CRON cada viernes a las 18:00. Requiere rol ADMIN."
          },
          "response": []
        },
        {
          "name": "Clean Old Workshifts (DELETE /cleanup)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workshifts/cleanup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workshifts", "cleanup"]
            },
            "description": "Elimina turnos con más de 12 meses de antigüedad. Requiere rol ADMIN."
          },
          "response": []
        }
      ]
    }
  ]
}