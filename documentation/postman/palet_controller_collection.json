{
  "info": {
    "name": "Inventario Automatizado - Palets API (RFID)",
    "description": "Colección completa de endpoints para gestión de palets con tecnología RFID. Incluye registro automático, check-in, trazabilidad, alertas de caducidad y estadísticas de producción.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Palet Management (CRUD)",
      "description": "Operaciones CRUD básicas de palets. Registro automático con check-in y trazabilidad completa.",
      "item": [
        {
          "name": "Create Palet (POST) - Escaneo RFID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sscc\": \"123456789012345678\",\n  \"packLevelId\": 1,\n  \"userId\": {{userId}},\n  \"batchNumber\": \"LOTE-2025-001\",\n  \"expiryDate\": \"2025-12-31\",\n  \"quantity\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/palets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "palets"]
            },
            "description": "Registra un nuevo palet escaneado. Incluye check-in automático si es el primer escaneo del día. Requiere rol ADMIN, SUPERVISOR u OPERATOR."
          },
          "response": []
        },
        {
          "name": "Get Recent 7 Palets (GET /recent-7)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/palets/recent-7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "palets", "recent-7"]
            },
            "description": "Obtiene los 7 palets más recientes para notificaciones en tiempo real."
          },
          "response": []
        },
        {
          "name": "Get Palet by ID (GET /palets/{id})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/palets/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "palets", "1"]
            },
            "description": "Obtiene un palet específico por su ID con detalles completos."
          },
          "response": []
        },
        {
          "name": "Get Palet by SSCC (GET /palets/sscc/{sscc})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/palets/sscc/123456789012345678",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "palets", "sscc", "123456789012345678"]
            },
            "description": "Busca un palet usando su código SSCC único (18 dígitos)."
          },
          "response": []
        },
        {
          "name": "Get All Palets (Paginated) (GET /palets)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/palets?page=0&size=20&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "palets"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "createdAt,desc"
                }
              ]
            },
            "description": "Lista todos los palets con paginación. Ordenado por fecha de creación descendente por defecto."
          },
          "response": []
        },
        {
          "name": "Update Palet (PUT /palets/{id})",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sscc\": \"123456789012345678\",\n  \"batchNumber\": \"LOTE-2025-001-UPDATED\",\n  \"expiryDate\": \"2025-12-31\",\n  \"quantity\": 950\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/palets/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "palets", "1"]
            },
            "description": "Actualiza un palet existente. Solo supervisores y administradores."
          },
          "response": []
        },
        {
          "name": "Delete Palet (DELETE /palets/{id})",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/palets/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "palets", "1"]
            },
            "description": "Elimina un palet. Solo administradores pueden eliminar palets."
          },
          "response": []
        }
      ]
    },
