{
  "info": {
    "name": "Inventario Automatizado - Timesheets API (Fichajes)",
    "description": "Colección completa de endpoints para gestión de fichajes y control horario. Los fichajes normales se realizan mediante check-in/check-out. Las operaciones manuales son solo para correcciones administrativas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Timesheet CRUD (Admin/Supervisor)",
      "description": "Operaciones CRUD directas. SOLO para correcciones administrativas excepcionales.",
      "item": [
        {
          "name": "Create Timesheet Manually (EXCEPCIONAL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workshiftId\": 15,\n  \"checkInAt\": \"2025-05-09T07:05:00\",\n  \"checkOutAt\": \"2025-05-09T15:10:00\",\n  \"notes\": \"Registro manual por fallo en terminal de fichaje. Aprobado por supervisor.\",\n  \"status\": \"CLOSED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets"]
            },
            "description": "SOLO para correcciones administrativas. Los fichajes normales deben usar check-in/check-out. Requiere rol ADMIN o SUPERVISOR."
          },
          "response": []
        },
        {
          "name": "Get Timesheet by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets/{{timesheetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets", "{{timesheetId}}"]
            },
            "description": "Obtiene un fichaje específico por su ID con información detallada."
          },
          "response": []
        },
        {
          "name": "Get All Timesheets (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets?page=0&size=20&sort=checkInAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "checkInAt,desc"
                }
              ]
            },
            "description": "Lista todos los fichajes con paginación. Requiere rol ADMIN o SUPERVISOR."
          },
          "response": []
        },
        {
          "name": "Update Timesheet (EXCEPCIONAL)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workshiftId\": 15,\n  \"checkInAt\": \"2025-05-09T07:00:00\",\n  \"checkOutAt\": \"2025-05-09T15:00:00\",\n  \"notes\": \"Corrección de hora de entrada. El empleado llegó a las 07:00 según cámaras de seguridad.\",\n  \"status\": \"CLOSED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets/{{timesheetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets", "{{timesheetId}}"]
            },
            "description": "SOLO para correcciones administrativas. Requiere justificación en el campo notes. Requiere rol ADMIN o SUPERVISOR."
          },
          "response": []
        },
        {
          "name": "Delete Timesheet",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets/{{timesheetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets", "{{timesheetId}}"]
            },
            "description": "Elimina un fichaje. Usar con precaución - los datos históricos se pierden. Solo ADMIN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Check-In / Check-Out",
      "description": "Operaciones estándar de registro de entrada y salida de empleados.",
      "item": [
        {
          "name": "Check-In (Registrar Entrada)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets/check-in/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets", "check-in", "{{userId}}"]
            },
            "description": "Registra la entrada de un empleado. Crea automáticamente un timesheet para el turno asignado del día. Detecta tardanzas automáticamente."
          },
          "response": []
        },
        {
          "name": "Check-In with Specific Time (ADMIN)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets/check-in/{{userId}}/at/2025-05-09T07:03:00",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets", "check-in", "{{userId}}", "at", "2025-05-09T07:03:00"]
            },
            "description": "Para correcciones administrativas. Permite especificar la hora exacta del check-in (formato ISO 8601). Requiere rol ADMIN o SUPERVISOR."
          },
          "response": []
        },
        {
          "name": "Check-Out (Registrar Salida)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets/check-out/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets", "check-out", "{{userId}}"]
            },
            "description": "Registra la salida de un empleado. Cierra el timesheet abierto y calcula horas trabajadas. Detecta anomalías automáticamente."
          },
          "response": []
        },
        {
          "name": "Check-Out with Specific Time (ADMIN)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/timesheets/check-out/{{userId}}/at/2025-05-09T15:00:00",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "timesheets", "check-out", "{{userId}}", "at", "2025-05-09T15:00:00"]
            },
            "description": "Para correcciones administrativas. Permite especificar la hora exacta del check-out (formato ISO 8601). Requiere rol ADMIN o SUPERVISOR."
          },
          "response": []
        }
      ]
    },
